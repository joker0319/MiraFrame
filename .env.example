# ============================================
# MiraFrame Backend Configuration
# 复制此文件为 .env 后填写实际值
# 默认值对齐老项目 backend/.env
# ============================================

# ── 基础设置 ──
APP_NAME=MiraFrame-backend
NODE_ENV=dev
LOG_LEVEL=info
PORT=3000

# ── 数据库 (PostgreSQL) ──
DATABASE_URL=postgres://postgres:postgres@localhost:5432/miraframe

# ── Redis (确认信号 + BullMQ) ──
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ── CORS (JSON 数组或逗号分隔) ──
CORS_ORIGINS=["http://localhost:15173", "http://127.0.0.1:15173"]

# ── Admin Token ──
ADMIN_TOKEN=

# ════════════════════════════════════════════
# 文本生成 (OpenAI 兼容接口)
# ════════════════════════════════════════════

# 可选值: openai | fake
TEXT_PROVIDER=fake
TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TEXT_API_KEY=your_text_api_key
TEXT_MODEL=deepseek-v4-flash
TEXT_ENDPOINT=/chat/completions
TEXT_ENABLE_THINKING=false
FAKE_TEXT_RESPONSE=

# ── 多 provider 降级（可选） ──
# 按顺序尝试，第一个成功即返回；不配 TEXT_PROVIDERS 时只用上面那一个，行为不变。
# 每项的 TEXT_<NAME>_BASE_URL / _API_KEY / _MODEL 覆盖通用 TEXT_*，缺省自动继承。
# 名字里带 fake 的候选（如 local-fake）默认走演示桩，可用于「真实 provider 全挂时兜底」。
# TEXT_PROVIDERS=agnes,kimi,local-fake
# TEXT_KIMI_BASE_URL=https://api.moonshot.cn/v1
# TEXT_KIMI_API_KEY=
# TEXT_KIMI_MODEL=kimi-k3
# TEXT_LOCAL_FAKE_PROVIDER=fake

# ── 熔断参数（全局，也可用 TEXT_PROVIDER_* / IMAGE_PROVIDER_* / VIDEO_PROVIDER_* 单独覆盖） ──
# 连续失败多少次进入冷却、首次冷却毫秒、冷却上限毫秒（连续熔断时指数翻倍到上限）
# PROVIDER_FAILURE_THRESHOLD=3
# PROVIDER_COOLDOWN_MS=30000
# PROVIDER_MAX_COOLDOWN_MS=300000

# ════════════════════════════════════════════
# 图像生成 (OpenAI 兼容接口 — 阿里云 DashScope)
# ════════════════════════════════════════════

# 可选值: openai | fake
IMAGE_PROVIDER=fake
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_API_KEY=your_image_api_key
IMAGE_MODEL=qwen-image-2.0-pro
IMAGE_ENDPOINT=/services/aigc/multimodal-generation/generation
ENABLE_IMAGE_TO_IMAGE=false
FAKE_IMAGE_FIXTURE_URL=
# 多 provider 写法同上：IMAGE_PROVIDERS=主,备（每项 IMAGE_<NAME>_BASE_URL / _API_KEY / _MODEL）

# ════════════════════════════════════════════
# 视频生成 (阿里云 DashScope | 豆包 Seedance)
# ════════════════════════════════════════════

# 可选值: openai | fake
VIDEO_PROVIDER=fake
# DashScope 视频
VIDEO_BASE_URL=https://dashscope.aliyuncs.com/api/v1
VIDEO_API_KEY=your_video_api_key
VIDEO_MODEL=wan2.7-t2v
VIDEO_ENDPOINT=
VIDEO_MODE=text
ENABLE_IMAGE_TO_VIDEO=true
VIDEO_IMAGE_MODE=first_frame
VIDEO_INLINE_LOCAL_IMAGES=true
# Fake 视频
# FAKE_VIDEO_FIXTURE_URL=/static/videos/dev_clip.mp4
# FAKE_VIDEO_FIXTURE_PATH=/absolute/path/to/dev_clip.mp4
# 多 provider 写法同上：VIDEO_PROVIDERS=主,备（每项 VIDEO_<NAME>_BASE_URL / _API_KEY / _MODEL）
# 注意：协议按 BASE_URL 嗅探（含 dashscope / agnes 走各自请求体），其余按通用 OpenAI 兼容处理。

# ════════════════════════════════════════════
# TTS / BGM
# ════════════════════════════════════════════
TTS_ENABLED=true
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
TTS_VOLUME=1.0
BGM_ENABLED=true
BGM_VOLUME=0.3
BGM_DIRECTORY=static/bgm

# ════════════════════════════════════════════
# 工作流控制
# ════════════════════════════════════════════

# 思考链可视化
THINKING_CHAIN_ENABLED=true
THINKING_CHAIN_DETAIL_LEVEL=normal

# Critic 质量审查（agent 包直接读 CRITIC_* 前缀，勿写成 CRITIQUE_*）
CRITIC_SCORE_THRESHOLD=6.0
CRITIC_MAX_ROUNDS=2

# 大纲审批
OUTLINE_ENABLED=true

# 请求超时（秒）
REQUEST_TIMEOUT_S=120.0

# 对外可访问 URL（用于生成 /static 完整 URL）
PUBLIC_BASE_URL=http://localhost:3000
